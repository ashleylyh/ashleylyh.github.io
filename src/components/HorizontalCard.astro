---
const { title, img, desc, url, badge, award, tags, target = "_blank", maxTags } = Astro.props;
const shownTags = tags && maxTags ? tags.slice(0, maxTags) : tags;
import { Image } from "astro:assets";
const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";
---

<!--
  The whole card is clickable through the title link, whose ::after covers the card ("stretched link").
  Tags are separate links layered above it (relative z-10), so links are never nested inside links.
-->
<div class="relative rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]">
  <div class="hero-content flex-col md:flex-row">
    {
      img && (
        <Image
          src={img}
          width={750}
          height={422}
          format="webp"
          alt={title}
          class="max-w-full md:max-w-[13rem] rounded-lg"
        />
      )
    }
    <div class="grow w-full">
      <h1 class="text-xl font-bold">
        <a href={url} target={target} class="after:absolute after:inset-0 after:rounded-lg">{title}</a>
        {award && <div class="badge badge-warning border-0 mx-2 whitespace-nowrap">🏆 {award}</div>}
        {badge && <div class="badge badge-error border-0 mx-2">{badge}</div>}
      </h1>
      <p class="py-1 text-1xl">{desc}</p>
      {
        shownTags && shownTags.length > 0 && (
          <div class="relative z-10 card-actions justify-start mt-1">
            {shownTags.map((tag) => (
              <a href={`${tag_url}/${tag}`} class="badge badge-info border-0 hover:brightness-95">
                {tag}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</div>

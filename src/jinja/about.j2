<!-- about.j2 -->
<article class="about  active" data-page="about">
  <header>
    <h2 class="h2 article-title">{{about.HEADER.label}}</h2>
  </header>

  <!--- PRESENTATION --->
  <section class="about-text">
    {% for line in about.PRESENTATION.description.split('\n') %}
      {% if line.strip() %}
      <p>
        {% for part in line.split('**') %}
          {% if loop.index % 2 == 1 %}
            {{ part }}
          {% else %}
            <strong class="highlight">{{ part }}</strong>
          {% endif %}
        {% endfor %}
      </p>
      {% endif %}
    {% endfor %}
  </section>

  <!--- DOING -->
  {% if about.DOING.enabled %}
  <section class="service">
    <h3 class="h3 service-title">What i'm doing</h3>
    <ul class="service-list">
      {% for item in about.DOING["items"] %}
      <li class="service-item">
        <div class="service-icon-box">
          <ion-icon name="{{item.icon}}" alt="design icon"></ion-icon>
        </div>
        <div class="service-content-box">
          <h4 class="h4 service-item-title">{{item.title}}</h4>
          <p class="service-item-text">
            {{item.description}}
          </p>
        </div>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <!--- SKILLS -->
  {% if about.SKILLS.enabled %}
  <section class="testimonials">
    <h3 class="h3 testimonials-title">{{about.SKILLS.label}}</h3>
    <ul class="testimonials-list has-scrollbar">
      {% for item in about.SKILLS["items"] %}
      <li class="testimonials-item">
        <div class="content-card" data-testimonials-item>
          <figure class="testimonials-avatar-box">
            <img src="{{item.icon}}" alt="{{item.title}}" width="60" data-testimonials-avatar>
          </figure>
          <h4 class="h4 testimonials-item-title" data-testimonials-title>{{item.title}}</h4>
          <div class="testimonials-text" data-testimonials-text>
            <p>
              {{item.description}}
            </p>
          </div>
        </div>
      </li>
      {% endfor %}
      < </ul>
  </section>

  <!--- popup modal -->
  <div class="modal-container" data-modal-container>
    <div class="overlay" data-overlay></div>
    <section class="testimonials-modal">
      <button class="modal-close-btn" data-modal-close-btn>
        <ion-icon name="close-outline"></ion-icon>
      </button>
      <div class="modal-img-wrapper">
        <figure class="modal-avatar-box">
          <img src="./src/images/avatar-1.png" alt="{{profile.USER.name}}" width="80" data-modal-img>
        </figure>
        <img src="config/assets/icons/ellipsis.svg" alt="quote icon">
      </div>
      <div class="modal-content">
        <h4 class="h3 modal-title" data-modal-title>{{profile.USER.name}}</h4>
        {# lorem #}
        <div data-modal-text>
          <p>
            {# lorem #}
          </p>
        </div>
      </div>
    </section>
  </div>
  {% endif %}

  <!--- TECHNOLOGIES-->
  {% if about.TECHNOLOGIES.enabled %}
  <section class="clients">
    <h3 class="h3 clients-title">{{about.TECHNOLOGIES.label}}</h3>
    {% for section in about.TECHNOLOGIES["sections"] %}
    <div class="technology-section">
      <h4 class="h4 technology-section-title">{{section.title}}</h4>
      <ul class="clients-list has-scrollbar">
        {% for item in section["items"] %}
        <li class="clients-item" data-title="{{item.title}}">
          <a href="#">
            <img src="{{item.icon}}" alt="{{item.title}}" width="50" height="50">
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </section>
  {% endif %}


  <!-- LANGUAGES -->
  {% if about.LANGUAGES.enabled %}
  <section class="skill">
    <h3 class="h3 skills-title">{{about.LANGUAGES.label}}</h3>
    <ul class="skills-list content-card">
      {% for item in about.LANGUAGES["items"] %}
      <li class="skills-item">
        <div class="title-wrapper">
          <h5 class="h5">{{item.language}}</h5>
          {% if about.LANGUAGES.display_percentage_values %}
          <data value="{{item.proficiency[:-1]}}">{{item.proficiency}}</data>
          {% endif %}
        </div>
        {% if about.LANGUAGES.display_progress_bars %}
        <div class="skill-progress-bg">
          <div class="skill-progress-fill" style="width: {{item.proficiency}};"></div>
        </div>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
  </section>
  <br>
  {% endif %}

  <!--- CERTIFICATES -->
  {% if about.CERTIFICATES.enabled %}
  <section class="certificates">
    <h3 class="h3 certificates-title">{{about.CERTIFICATES.label}}</h3>
    <ul class="certificates-list">
      {% for item in about.CERTIFICATES["items"] %}
      <li class="certificates-item">
        {% if item.link and item.link != "#" %}
        <a href="{{item.link}}" target="_blank" rel="noopener noreferrer" class="certificate-link">
          <div class="certificate-content">
            <div class="certificate-icon">
              <ion-icon name="ribbon-outline"></ion-icon>
            </div>
            <h4 class="h4 certificate-name">{{item.title}}</h4>
            <div class="external-link-icon">
              <ion-icon name="open-outline"></ion-icon>
            </div>
          </div>
        </a>
        {% else %}
        <div class="certificate-content">
          <div class="certificate-icon">
            <ion-icon name="ribbon-outline"></ion-icon>
          </div>
          <h4 class="h4 certificate-name">{{item.title}}</h4>
        </div>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}
</article>
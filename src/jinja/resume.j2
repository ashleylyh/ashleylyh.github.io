<!-- resume.j2 -->
<article class="resume" data-page="resume">
  <header>
    <h2 class="h2 article-title">{{resume.HEADER.label}}</h2>
  </header>

  <!-- EDUCATION -->
  {% if resume.EDUCATION.enabled %}
  <section class="timeline">
    <div class="title-wrapper">
      <div class="icon-box">
        <ion-icon name="book-outline"></ion-icon>
      </div>
      <h3 class="h3">{{resume.EDUCATION.label}}</h3>
    </div>
    <ol class="timeline-list">
      {% for item in resume.EDUCATION["items"] | reverse %}
      <li class="timeline-item">
        <h4 class="h4 timeline-item-title">
          {% if item.logo %}
          <img src="{{item.logo}}" alt="School logo" class="position-logo">
          {% endif %}
          {{item.institution}}
        </h4>
        <span>{{item.period}}</span>
        {% if item.description %}
        <div class="timeline-text">
          {% if item.description is string %}
            {% for line in item.description.split('\n') %}
              {% if line.strip() %}
              <p>{{ line.strip() }}</p>
              {% endif %}
            {% endfor %}
          {% else %}
            {% for point in item.description %}
            <p>{{ point }}</p>
            {% endfor %}
          {% endif %}
        </div>
        {% endif %}
        {% if item.coursework %}
        <div class="coursework">
          <h5 class="coursework-title">Coursework</h5>
          <ul class="coursework-list">
            {% for course in item.coursework %}
            <li class="coursework-item">{{ course }}</li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
      </li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}

  <!-- EXPERIENCE -->
  {% if resume.EXPERIENCE.enabled %}
  <section class="timeline">
    <div class="title-wrapper">
      <div class="icon-box">
        <ion-icon name="bar-chart-outline"></ion-icon>
      </div>
      <h3 class="h3">{{resume.EXPERIENCE.label}}</h3>
    </div>
    <ol class="timeline-list">
      {% for item in resume.EXPERIENCE["items"] %}
      <li class="timeline-item">
        <h4 class="h4 timeline-item-title">
          {% if item.logo %}
            {% if item.logo_link %}
            <a href="{{item.logo_link}}" target="_blank" rel="noopener noreferrer" class="position-logo-link">
              <img src="{{item.logo}}" alt="Company logo" class="position-logo">
            </a>
            {% else %}
            <img src="{{item.logo}}" alt="Company logo" class="position-logo">
            {% endif %}
          {% endif %}
          {{item.position}}
        </h4>
        <span>{{item.period}}</span>
        {% if item.description %}
        <ul class="experience-list">
          {% if item.description is string %}
            {% for line in item.description.split('\n') %}
              {% if line.strip() %}
              <li class="experience-item">
                {% set formatted_line = line.strip() %}
                {% for part in formatted_line.split('**') %}
                  {% if loop.index % 2 == 1 %}
                    {{ part }}
                  {% else %}
                    <strong>{{ part }}</strong>
                  {% endif %}
                {% endfor %}
              </li>
              {% endif %}
            {% endfor %}
          {% else %}
            {% for point in item.description %}
            <li class="experience-item">
              {% for part in point.split('**') %}
                {% if loop.index % 2 == 1 %}
                  {{ part }}
                {% else %}
                  <strong>{{ part }}</strong>
                {% endif %}
              {% endfor %}
            </li>
            {% endfor %}
          {% endif %}
        </ul>
        {% endif %}
        {% if item.technologies %}
        <p class="experience-tech">
          <strong>Skills:</strong>
          {{ item.technologies | join(', ') }}
        </p>
        {% endif %}
      </li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}

  <!-- AWARD -->
  {% if resume.AWARD.enabled %}
  <section class="timeline">
    <div class="title-wrapper">
      <div class="icon-box">
        <ion-icon name="trophy-outline"></ion-icon>
      </div>
      <h3 class="h3">{{ resume.AWARD.label }}</h3>
    </div>
    <ol class="timeline-list">
      {% for item in resume.AWARD["items"] | reverse %}
      <li class="timeline-item">
        <h4 class="h4 timeline-item-title">{{ item.title }}</h4>
        <span>{{ item.date }}</span>
        {% if item.description %}
        <p class="timeline-text">{{ item.description }}</p>
        {% endif %}
      </li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}

</article>
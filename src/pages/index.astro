---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import PublicationItem from "../components/PublicationItem.astro";
import { getPublications } from "../lib/publications";
import { getProjects, projectUrl } from "../lib/projects";

// Content lives in src/content/pages/home.md (intro) and src/content/projects/*.md (featured: true)
const homeEntry = (await getCollection("pages")).find((p) => p.slug === "home")!;
const home = homeEntry.data;
const { Content: Intro } = await homeEntry.render();
const featured = (await getProjects()).filter((p) => p.data.featured);

// src/content/publications/*.md with selected: true
const selectedPubs = (await getPublications()).filter((p) => p.data.selected);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">{home.greeting}</div>
    <div class="text-5xl font-bold">{home.name}</div>
    <div class="text-3xl py-3 font-bold">{home.headline}</div>
    <div class="py-2 text-lg">
      <Intro />
    </div>
    {
      home.cta && (
        <div class="mt-8">
          <a class="btn btn-outline ml-5" href={home.cta.url} target="_blank">{home.cta.label}</a>
        </div>
      )
    }
  </div>

  {/*
    selectedPubs.length > 0 && (
      <div class="mb-12">
        <div class="flex items-baseline justify-between gap-4">
          <div class="text-3xl font-bold">Selected Publications</div>
          <a href="/publications" class="link text-sm whitespace-nowrap">All publications →</a>
        </div>
        <div class="divide-y divide-base-300">
          {selectedPubs.map((entry) => (
            <PublicationItem entry={entry} />
          ))}
        </div>
      </div>
    )
  */}

  <div>
    <div class="text-3xl w-full font-bold mb-2">My last projects</div>
  </div>

  {
    featured.map((project, i) => (
      <>
        {i > 0 && <div class="divider my-0" />}
        <HorizontalCard
          title={project.data.title}
          img={project.data.heroImage}
          desc={project.data.description}
          url={projectUrl(project)}
          target="_self"
          badge={project.data.badge}
          award={project.data.award}
          tags={project.data.tags}
          maxTags={6}
        />
      </>
    ))
  }
</BaseLayout>

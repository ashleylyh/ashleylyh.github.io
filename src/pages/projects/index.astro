---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import { getProjects, groupByCategory, projectUrl } from "../../lib/projects";

// Content lives in src/content/projects/*.md
const groups = groupByCategory(await getProjects());
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  {
    groups.map(([category, projects], i) => (
      <>
        <div class:list={["text-3xl w-full font-bold mb-5", { "mt-10": i > 0 }]}>{category}</div>
        {projects.map((project, j) => (
          <>
            {j > 0 && <div class="divider my-0" />}
            <HorizontalCard
              title={project.data.title}
              img={project.data.heroImage}
              desc={project.data.description}
              url={projectUrl(project)}
              target="_self"
              badge={project.data.badge}
              award={project.data.award}
              tags={project.data.tags}
              maxTags={6}
            />
          </>
        ))}
      </>
    ))
  }
</BaseLayout>

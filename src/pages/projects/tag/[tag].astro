---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import HorizontalCard from "../../../components/HorizontalCard.astro";
import { getProjects, projectUrl } from "../../../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  const tags = [...new Set(projects.flatMap((p) => p.data.tags || []))];
  return tags.map((tag) => ({
    params: { tag },
    props: { projects: projects.filter((p) => p.data.tags?.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { projects } = Astro.props;
---

<BaseLayout title={"Projects - " + tag} sideBarActiveItemID="projects">
  <div class="text-3xl w-full font-bold mb-5">Projects - {tag}</div>
  {
    projects.map((project, i) => (
      <>
        {i > 0 && <div class="divider my-0" />}
        <HorizontalCard
          title={project.data.title}
          img={project.data.heroImage}
          desc={project.data.description}
          url={projectUrl(project)}
          target="_self"
          badge={project.data.badge}
          award={project.data.award}
          tags={project.data.tags}
          maxTags={6}
        />
      </>
    ))
  }
</BaseLayout>
